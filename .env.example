# Reels content moderation (specs/021-reels-video-feed, v3 — upload + moderation)
# 'stub' (default): dev/test provider, flags uploads whose filename or
#   description contains "nsfw-test" — no external credentials needed.
# 'sightengine': calls the real Sightengine video + text moderation APIs.
MODERATION_PROVIDER=stub
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Reels reporting & reposting (specs/021-reels-video-feed, v4)
# Unique-reporter count at which a published reel auto-hides.
REEL_REPORT_AUTOHIDE_THRESHOLD=25
# Max reports a single user may submit per day (across all reels).
REEL_REPORT_DAILY_LIMIT=20
# Guards PATCH /api/reels/:id/moderation and GET /api/reels/moderation/hidden
# (x-admin-key header). No default — set a real secret before deploying.
ADMIN_API_KEY=