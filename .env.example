PORT=
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
REDIS_URL=
LIVEKIT_API_KEY=
LIVEKIT_WS_URL=
LIVEKIT_API_SECRET=
FIREBASE_SERVICE_ACCOUNT=

# Reels content moderation (specs/021-reels-video-feed, v3 — upload + moderation)
# 'stub' (default): dev/test provider, flags uploads whose filename or
#   description contains "nsfw-test" — no external credentials needed.
# 'sightengine': calls the real Sightengine video + text moderation APIs.
MODERATION_PROVIDER=stub
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Reels reporting & reposting (specs/021-reels-video-feed, v4)
# Unique-reporter count at which a published reel auto-hides.
REEL_REPORT_AUTOHIDE_THRESHOLD=25
# Max reports a single user may submit per day (across all reels).
REEL_REPORT_DAILY_LIMIT=20
# Guards PATCH /api/reels/:id/moderation and GET /api/reels/moderation/hidden
# (x-admin-key header). No default — set a real secret before deploying.
ADMIN_API_KEY=
# Kids allowance (specs/026-kids-allowance-watch)
# Card issuer: 'stub' (default; simulated cards). NymCard is added by a later feature.
ISSUER_PROVIDER=stub
# Cap on any single amount field, in halalas (1000000 = 10,000.00 SAR).
ALLOWANCE_MAX_AMOUNT_HALALAS=1000000
# Cap on a child's request for more money, in halalas (50000 = 500.00 SAR).
ALLOWANCE_MAX_REQUEST_HALALAS=50000
# ADMIN_API_KEY above also guards /dev/* (non-production only) and /admin/ledger/*.
# MONGODB_URI must point at a replica set (replicaSet=rs0). Without one, money
# features are disabled and return 503 LEDGER_UNAVAILABLE.

# Watch background push via APNs (optional locally; disabled with a warning if unset)
APNS_KEY_ID=
APNS_TEAM_ID=TY73VN2JFG
# Contents of AuthKey_XXXX.p8, with newlines escaped as \n
APNS_PRIVATE_KEY=
APNS_WATCH_TOPIC=com.cirochat.zooz.chinaparts.watchkitapp
# sandbox | production
APNS_ENV=sandbox
# Optional: ops alerts (ledger mismatch, payout system failure) are POSTed here as JSON.
OPS_ALERT_WEBHOOK_URL=
